{
  "name": "@happydesigns/composable-variants",
  "version": "0.3.0-rc.1",
  "description": "Typed, composable variants for data and Comark Content.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happydesigns/nuxt-variants.git",
    "directory": "packages/composable-variants"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/core.mjs",
  "types": "./dist/core.d.mts",
  "exports": {
    ".": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./comark-content": {
      "types": "./dist/comark-content.d.mts",
      "import": "./dist/comark-content.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.mts",
      "import": "./dist/devtools.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "import": "./dist/internal.mjs"
    },
    "./internal/inspector": {
      "types": "./dist/inspector.d.mts",
      "import": "./dist/inspector.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "defu": "^6.1.7"
  },
  "peerDependencies": {
    "comark-content": "^0.6.2",
    "devframe": "^1.3.5"
  },
  "peerDependenciesMeta": {
    "comark-content": {
      "optional": true
    },
    "devframe": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
