{
  "name": "@happydesigns/nuxt-variants",
  "version": "0.3.0-next.1",
  "description": "Composable page capabilities for Nuxt with typed config inheritance and Nuxt Content schema merging.",
  "keywords": [
    "nuxt",
    "nuxt-content",
    "nuxt-module",
    "typescript",
    "variants"
  ],
  "homepage": "https://github.com/happydesigns/nuxt-variants#readme",
  "bugs": {
    "url": "https://github.com/happydesigns/nuxt-variants/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happydesigns/nuxt-variants.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "schemas": [
        "./dist/schemas.d.mts"
      ],
      "core": [
        "./dist/core.d.mts"
      ],
      "content": [
        "./dist/content.d.mts"
      ],
      "devtools": [
        "./dist/devtools.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "import": "./dist/schemas.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "import": "./dist/content.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.mts",
      "import": "./dist/devtools.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "nuxt-module-build build && pnpm build:client",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && pnpm build:client",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "release": "pnpm release:auth && pnpm lint && pnpm typecheck && pnpm test && pnpm prepack && changelogen --release && npm publish && git push --follow-tags",
    "release:auth": "npm whoami || npm login --auth-type=web",
    "check": "pnpm dev:prepare && pnpm lint && pnpm typecheck && pnpm test",
    "lint": "oxfmt --check && oxlint .",
    "lint:fix": "oxfmt && oxlint .",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit && cd ../client && vue-tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run test/bench --reporter=verbose",
    "compare": "node examples/comparison/server.mjs",
    "compare:presets": "node examples/comparison/article-event.mts",
    "compare:prepare": "pnpm prepack && node examples/comparison/prepare-baseline.mjs",
    "test:package": "node scripts/check-packed.mjs",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^4.2.0",
    "@nuxt/kit": "^4.6.4",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxt/ui": "^4.12.2",
    "@types/node": "^22.20.5",
    "@vitejs/devtools-kit": "^0.8.3",
    "@vitest/coverage-v8": "^5.1.0",
    "changelogen": "^0.6.2",
    "comark-content": "^0.6.2",
    "devframe": "^1.3.5",
    "nuxt": "^4.6.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "valibot": "^1.5.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "comark-content": "^0.6.2",
    "devframe": "^1.3.5",
    "valibot": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "comark-content": {
      "optional": true
    },
    "devframe": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
