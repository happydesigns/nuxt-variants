{
  "name": "@happydesigns/nuxt-variants",
  "version": "0.0.5",
  "description": "A centralized, deeply-merging configuration engine for Nuxt layouts with build-time variant graph and Nuxt Content v3 schema merging.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happydesigns/nuxt-variants.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "schemas": [
        "./dist/schemas.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "import": "./dist/schemas.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "nuxt-module-build build && pnpm build:client",
    "prepare": "nuxt-module-build build --stub && pnpm build:client && nuxt-module-build prepare && nuxt prepare playground",
    "dev": "pnpm prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "docs": "pnpm docs:dev",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "oxfmt --check && oxlint .",
    "lint:fix": "oxfmt && oxlint .",
    "lint:check": "pnpm lint",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit && cd ../client && vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit && cd ../client && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "3.2.4",
    "@nuxt/kit": "^4.4.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/devtools-ui-kit": "3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "latest",
    "@vitest/coverage-v8": "4.1.2",
    "changelogen": "^0.6.2",
    "defu": "^6.1.7",
    "nuxt": "^4.4.2",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "~6.0.2",
    "unbuild": "^3.6.1",
    "valibot": "^1.3.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@11.0.9"
}
