{
  "name": "@happydesigns/config-variants",
  "version": "0.3.0-rc.1",
  "description": "Typed configuration variants for data, Comark Content, and Nuxt.",
  "keywords": [
    "comark-content",
    "nuxt",
    "nuxt-content",
    "nuxt-module",
    "typescript",
    "variants"
  ],
  "homepage": "https://github.com/happydesigns/config-variants#readme",
  "bugs": {
    "url": "https://github.com/happydesigns/config-variants/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happydesigns/config-variants.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/core.mjs",
  "types": "./dist/core.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/core.d.mts"
      ],
      "nuxt": [
        "./dist/module.d.mts"
      ],
      "schemas": [
        "./dist/schemas.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./nuxt": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "import": "./dist/schemas.mjs"
    },
    "./comark-content": {
      "types": "./dist/comark-content.d.mts",
      "import": "./dist/comark-content.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.mts",
      "import": "./dist/devtools.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "import": "./dist/internal.mjs"
    },
    "./internal/inspector": {
      "types": "./dist/inspector.d.mts",
      "import": "./dist/inspector.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build:module": "unbuild --stub && nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "pnpm build:module && pnpm build:client",
    "dev:prepare": "pnpm build:module && nuxt prepare playground && pnpm build:client",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "release:preview": "changelogen --no-output",
    "release:prepare": "pnpm check && pnpm test:package",
    "release": "changelogen --release --no-github --clean",
    "release:check": "node scripts/github-release.mjs --check",
    "check": "pnpm dev:prepare && pnpm lint && pnpm typecheck && pnpm test",
    "lint": "oxfmt --check && oxlint .",
    "lint:fix": "oxfmt && oxlint .",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit && cd ../client && vue-tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run test/bench --reporter=verbose",
    "compare": "node examples/comparison/server.mjs",
    "compare:presets": "node examples/comparison/article-event.mts",
    "compare:prepare": "pnpm prepack && node examples/comparison/prepare-baseline.mjs",
    "test:package": "node scripts/check-packed.mjs",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^4.2.0",
    "@nuxt/kit": "^4.6.4",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxt/ui": "catalog:",
    "@types/node": "^22.20.5",
    "@vitejs/devtools-kit": "^0.8.3",
    "@vitest/coverage-v8": "^5.1.1",
    "changelogen": "^0.6.2",
    "comark-content": "catalog:",
    "devframe": "catalog:",
    "nuxt": "catalog:",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "shiki": "^4.6.0",
    "tailwindcss": "catalog:",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "valibot": "^1.5.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "comark-content": "catalog:",
    "devframe": "catalog:",
    "valibot": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "comark-content": {
      "optional": true
    },
    "devframe": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
